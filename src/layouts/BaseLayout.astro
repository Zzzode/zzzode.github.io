---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { type Lang, defaultLang, switchLocalePath, t } from '../i18n/ui';
import { getLocalized } from '../lib/content';
import { isDaily } from '../lib/post-policy';

interface Props {
  lang?: Lang;
  navPath?: string;
  title?: string;
  description?: string;
  /**
   * URL of this page in the other language.
   * - string: link the toggle there (translated page exists)
   * - null:   no translation exists, render the toggle as a non-link
   * - undefined: the counterpart route always exists (home/section pages)
   */
  alternatePath?: string | null;
  /** Bare pages (home) manage their own full-bleed sections and padding. */
  bare?: boolean;
}

const { lang = defaultLang, title, alternatePath, bare = false } = Astro.props;
const description = Astro.props.description ?? t(lang, 'site.description');

const siteName = 'Zzzode';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const altPath = alternatePath === undefined ? switchLocalePath(pathname, lang) : alternatePath;
const zhPath = lang === 'zh' ? pathname : altPath;
const enPath = lang === 'en' ? pathname : altPath;
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const prefix = lang === 'en' ? '/en' : '';

// Recent long-form posts for the palette's empty state (build-time only).
const recentPosts = (await getLocalized('posts', lang))
  .filter((post) => !isDaily(post))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
  .map((post) => ({
    title: post.data.title,
    href: `${prefix}/posts/${post.id.replace(/^(zh|en)\//, '')}/`,
  }));

const commandConfig = {
  locale: lang,
  pagefindBase: '/pagefind/',
  strings: {
    placeholder: t(lang, 'cmd.placeholder'),
    commands: t(lang, 'cmd.commands'),
    results: t(lang, 'cmd.results'),
    empty: t(lang, 'cmd.empty'),
    loading: t(lang, 'cmd.loading'),
    unavailable: t(lang, 'cmd.unavailable'),
    hint: t(lang, 'cmd.hint'),
  },
  commands: [
    { title: t(lang, 'nav.posts'), href: `${prefix}/posts/` },
    { title: t(lang, 'nav.daily'), href: `${prefix}/daily/` },
    { title: t(lang, 'nav.projects'), href: `${prefix}/projects/` },
    { title: t(lang, 'nav.talks'), href: `${prefix}/talks/` },
    { title: t(lang, 'nav.teaching'), href: `${prefix}/teaching/` },
    { title: t(lang, 'nav.publications'), href: `${prefix}/publications/` },
    { title: t(lang, 'nav.cv'), href: `${prefix}/cv/` },
    { title: t(lang, 'nav.about'), href: `${prefix}/about/` },
    { title: t(lang, 'nav.search'), href: `${prefix}/search/` },
  ],
  recent: recentPosts,
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-pagefind-filter={`locale:${lang}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={rssHref} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {enPath && (
      <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    )}
    {zhPath && (
      <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
    )}
    {zhPath && <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:image:alt" content={siteName} />
    <meta name="theme-color" content="#1d1d1f" />
    {import.meta.env.PROD && umamiWebsiteId && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={umamiWebsiteId}
        data-domains="zzzode.github.io"
        data-exclude-search="true"
        data-exclude-hash="true"
      ></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <script
      type="application/json"
      data-command-config
      data-pagefind-ignore
      set:html={JSON.stringify(commandConfig)}
    />
    <Nav lang={lang} alternatePath={altPath} activePath={Astro.props.navPath} />
    <main class:list={['flex-1', bare ? '' : 'container-page py-10 sm:py-14']}>
      <slot />
    </main>
    <Footer lang={lang} />
    <ClientRouter />
    <script>
      import '../scripts/choreography';
      import '../scripts/command-palette';
    </script>
  </body>
</html>
