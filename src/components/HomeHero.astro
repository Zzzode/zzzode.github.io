---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---

<section class="relative bg-white">
  <p class="hero-rail eyebrow" aria-hidden="true">{t(lang, 'home.eyebrow')}</p>
  <div
    data-hero-enter
    class="container-page flex flex-col items-center pb-10 pt-12 text-center sm:pb-14 sm:pt-16"
  >
    <p class="eyebrow hero-eyebrow">{t(lang, 'home.eyebrow')}</p>
    <h1
      class="mt-5 max-w-[900px] text-[clamp(32px,5.2vw,64px)] font-semibold leading-[1.08] tracking-[-0.035em]"
    >
      <span class="text-ink">{t(lang, 'home.titleA')}</span>
      <span class="text-muted">{t(lang, 'home.titleB')}</span>
    </h1>
    <p class="mt-6 max-w-[560px] text-[16px] leading-relaxed text-muted sm:text-[18px]">
      {t(lang, 'home.lead')}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      <a
        href={`${prefix}/posts/`}
        class="chevron-link inline-flex min-h-11 min-w-11 items-center gap-1 text-[15px] font-medium text-blue transition-colors hover:text-blue-hover"
      >
        {t(lang, 'home.viewWriting')}
        <span aria-hidden="true" class="chevron text-[1.05em] leading-none">›</span>
      </a>
      <a
        href={`${prefix}/about/`}
        class="chevron-link inline-flex min-h-11 min-w-11 items-center gap-1 text-[15px] font-medium text-ink-2 transition-colors hover:text-blue"
      >
        {t(lang, 'home.viewAbout')}
        <span aria-hidden="true" class="chevron text-[1.05em] leading-none">›</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Vertical edition label on the hero edge (lg+); below lg the centered
     horizontal eyebrow carries the same words. */
  .hero-rail {
    display: none;
  }
  .hero-eyebrow {
    display: block;
  }

  @media (min-width: 1024px) {
    .hero-rail {
      display: block;
      position: absolute;
      left: max(20px, calc(50% - 540px - 52px));
      top: 50%;
      transform: translateY(-50%);
      writing-mode: vertical-rl;
      margin: 0;
      letter-spacing: 0.32em;
      text-transform: none;
      white-space: nowrap;
      pointer-events: none;
    }
    .hero-eyebrow {
      display: none;
    }
  }
</style>
