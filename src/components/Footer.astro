---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<footer class="mt-8 border-t border-line-soft bg-white">
  <div
    class="container-page flex flex-col gap-3 py-7 text-[12.5px] text-muted-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/Zzzode"
        class="inline-flex items-center gap-1.5 transition-colors hover:text-blue"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          />
        </svg>
        {t(lang, 'footer.github')}
      </a>
      <a href={rssHref} class="inline-flex items-center gap-1.5 transition-colors hover:text-blue">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0Z" />
          <path d="M4 8.47v3.06c4.68 0 8.47 3.79 8.47 8.47h3.06C15.53 13.65 10.35 8.47 4 8.47Z" />
          <path d="M4 3v3.06c7.7 0 13.94 6.24 13.94 13.94H21C21 10.62 13.38 3 4 3Z" />
        </svg>
        {t(lang, 'footer.rss')}
      </a>
    </div>
    <div>© {new Date().getFullYear()} Zzzode · {t(lang, 'footer.built')}</div>
  </div>
</footer>
