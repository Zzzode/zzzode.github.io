---
interface Props {
  href: string;
  title: string;
  label: string;
  count: number;
}

const { href, title, label, count } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col justify-between rounded-card border border-line-soft bg-white p-6 transition-colors hover:border-line"
>
  <div>
    <p class="eyebrow">{label}</p>
    <h2
      class="mt-2.5 text-[19px] font-semibold tracking-[-0.015em] text-ink transition-colors group-hover:text-blue"
    >
      {title}
    </h2>
  </div>
  <div class="mt-6 flex items-center justify-between text-[13px] text-muted-2">
    <span>{count > 0 ? `${count} 项内容` : '暂无内容'}</span>
    <span class="text-lg leading-none text-muted-2" aria-hidden="true">›</span>
  </div>
</a>
