---
interface Props {
  href: string;
  title: string;
  label: string;
  /** pre-composed line, e.g. "3 项内容" / "1 item" / "Nothing yet" */
  meta: string;
}

const { href, title, label, meta } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col justify-between rounded-[18px] bg-white px-6 py-7"
>
  <div>
    <p class="eyebrow">{label}</p>
    <h2
      class="mt-2 text-[17px] font-semibold tracking-[-0.015em] text-ink transition-colors group-hover:text-blue"
    >
      {title}
    </h2>
  </div>
  <p class="mt-5 text-[12.5px] text-muted-2">{meta}</p>
</a>
