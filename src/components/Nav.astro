---
import { type Lang, languages, t } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** null means the other-language version of this page does not exist. */
  alternatePath: string | null;
}

const { lang, alternatePath } = Astro.props;

const items = [
  { href: '/posts/', key: 'nav.posts' },
  { href: '/talks/', key: 'nav.talks' },
  { href: '/teaching/', key: 'nav.teaching' },
  { href: '/publications/', key: 'nav.publications' },
  { href: '/cv/', key: 'nav.cv' },
] as const;

const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname;
const hrefFor = (href: string) => `${prefix}${href}`;
const isActive = (href: string) => path === hrefFor(href) || path.startsWith(hrefFor(href));

const toggleClass =
  'rounded-full border border-white/25 px-3 py-1 text-[13px] text-white/80 transition-colors hover:border-white/50 hover:text-white';
const toggleDisabledClass =
  'cursor-default rounded-full border border-white/10 px-3 py-1 text-[13px] text-white/35';
const toggleTitle = lang === 'zh' ? '本文暂无英文版' : 'No Chinese version yet';
---

<header
  class="sticky top-0 z-20 h-11 bg-[rgba(29,29,31,0.82)] backdrop-blur-xl"
>
  <div class="container-page flex h-11 items-center justify-between">
    <a
      href={`${prefix}/`}
      class="text-[16px] font-semibold tracking-[-0.01em] text-white"
    >
      Zzzode
    </a>

    <!-- desktop nav -->
    <nav class="hidden items-center gap-7 md:flex">
      {
        items.map((item) => (
          <a
            href={hrefFor(item.href)}
            hreflang={lang}
            class:list={[
              'text-[13px] transition-colors',
              isActive(item.href)
                ? 'text-white'
                : 'text-white/70 hover:text-white',
            ]}
          >
            {t(lang, item.key)}
          </a>
        ))
      }
      {
        alternatePath === null ? (
          <span class={toggleDisabledClass} aria-disabled="true" title={toggleTitle}>
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </span>
        ) : (
          <a
            href={alternatePath}
            hreflang={lang === 'zh' ? 'en' : 'zh-CN'}
            class={toggleClass}
          >
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </a>
        )
      }
    </nav>

    <!-- mobile nav: details/summary needs no JavaScript -->
    <div class="flex items-center gap-3 md:hidden">
      {
        alternatePath === null ? (
          <span class={toggleDisabledClass} aria-disabled="true">
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </span>
        ) : (
          <a
            href={alternatePath}
            hreflang={lang === 'zh' ? 'en' : 'zh-CN'}
            class="rounded-full border border-white/25 px-3 py-1 text-[13px] text-white/80"
          >
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </a>
        )
      }
      <details class="group relative">
        <summary
          class="flex h-11 w-9 list-none items-center justify-center text-white [&::-webkit-details-marker]:hidden"
          aria-label={t(lang, 'nav.menu')}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="17" y2="6"></line>
            <line x1="3" y1="14" x2="17" y2="14"></line>
          </svg>
        </summary>
        <nav
          class="fixed inset-x-0 top-11 z-30 border-t border-white/10 bg-ink px-5 py-2"
        >
          {
            items.map((item, i) => (
              <a
                href={hrefFor(item.href)}
                class:list={[
                  'block border-white/10 py-3 text-[15px] transition-colors',
                  i < items.length - 1 ? 'border-b' : '',
                  isActive(item.href) ? 'text-white' : 'text-white/80 hover:text-white',
                ]}
              >
                {t(lang, item.key)}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
