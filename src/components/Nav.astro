---
import { type Lang, languages, t } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** null means the other-language version of this page does not exist. */
  alternatePath: string | null;
}

const { lang, alternatePath } = Astro.props;

const items = [
  { href: '/posts/', key: 'nav.posts' },
  { href: '/talks/', key: 'nav.talks' },
  { href: '/teaching/', key: 'nav.teaching' },
  { href: '/publications/', key: 'nav.publications' },
  { href: '/cv/', key: 'nav.cv' },
] as const;

const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname;
const hrefFor = (href: string) => `${prefix}${href}`;
const isActive = (href: string) => path === hrefFor(href) || path.startsWith(hrefFor(href));

const toggleClass =
  'rounded-full border border-[rgba(245,245,247,0.22)] px-3 py-1 text-[12px] text-[rgba(245,245,247,0.85)] transition-colors hover:border-[rgba(245,245,247,0.55)] hover:text-[#f5f5f7]';
const toggleDisabledClass =
  'cursor-default rounded-full border border-[rgba(245,245,247,0.12)] px-3 py-1 text-[12px] text-[rgba(245,245,247,0.35)]';
const toggleTitle = lang === 'zh' ? '本文暂无英文版' : 'No Chinese version yet';
---

<header
  class="sticky top-0 z-20 h-11 border-b border-[rgba(245,245,247,0.08)] bg-[rgba(0,0,0,0.8)] backdrop-blur-[20px] backdrop-saturate-[1.8]"
>
  <div class="container-page flex h-11 items-center justify-between">
    <a href={`${prefix}/`} class="flex items-center gap-2.5" aria-label="Zzzode">
      <svg
        class="h-[18px] w-[18px] text-[#f5f5f7] transition-opacity hover:opacity-80"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M14 13 H51 L13 51 H50"
          stroke="currentColor"
          stroke-width="12.5"
          stroke-linecap="butt"
          stroke-linejoin="bevel"
        />
      </svg>
      <span class="text-[15px] font-semibold tracking-[-0.01em] text-[#f5f5f7]">Zzzode</span>
    </a>

    <!-- desktop nav -->
    <nav class="hidden items-center gap-8 md:flex">
      {
        items.map((item) => (
          <a
            href={hrefFor(item.href)}
            hreflang={lang}
            class:list={[
              'text-[12px] transition-colors',
              isActive(item.href)
                ? 'text-[#f5f5f7]'
                : 'text-[rgba(245,245,247,0.8)] hover:text-[#f5f5f7]',
            ]}
          >
            {t(lang, item.key)}
          </a>
        ))
      }
      {
        alternatePath === null ? (
          <span class={toggleDisabledClass} aria-disabled="true" title={toggleTitle}>
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </span>
        ) : (
          <a
            href={alternatePath}
            hreflang={lang === 'zh' ? 'en' : 'zh-CN'}
            class={toggleClass}
          >
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </a>
        )
      }
    </nav>

    <!-- mobile nav: details/summary needs no JavaScript -->
    <div class="flex items-center gap-3 md:hidden">
      {
        alternatePath === null ? (
          <span class={toggleDisabledClass} aria-disabled="true">
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </span>
        ) : (
          <a
            href={alternatePath}
            hreflang={lang === 'zh' ? 'en' : 'zh-CN'}
            class="rounded-full border border-[rgba(245,245,247,0.22)] px-3 py-1 text-[12px] text-[rgba(245,245,247,0.85)]"
          >
            {languages[lang === 'zh' ? 'en' : 'zh']}
          </a>
        )
      }
      <details class="group relative">
        <summary
          class="flex h-11 w-9 list-none items-center justify-center text-[#f5f5f7] [&::-webkit-details-marker]:hidden"
          aria-label={t(lang, 'nav.menu')}
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="17" y2="6"></line>
            <line x1="3" y1="14" x2="17" y2="14"></line>
          </svg>
        </summary>
        <nav
          class="fixed inset-x-0 top-11 z-30 border-t border-[rgba(245,245,247,0.1)] bg-[rgba(0,0,0,0.8)] px-5 pb-3 backdrop-blur-[20px] backdrop-saturate-[1.8]"
        >
          {
            items.map((item) => (
              <a
                href={hrefFor(item.href)}
                class:list={[
                  'block border-b border-[rgba(245,245,247,0.08)] py-3.5 text-[17px] transition-colors last:border-b-0',
                  isActive(item.href)
                    ? 'text-[#f5f5f7]'
                    : 'text-[rgba(245,245,247,0.8)] hover:text-[#f5f5f7]',
                ]}
              >
                {t(lang, item.key)}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
