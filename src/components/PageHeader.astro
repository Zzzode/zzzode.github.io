---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="mb-2">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1
    class="mt-3 text-[clamp(30px,4vw,40px)] font-semibold tracking-[-0.025em] text-ink"
  >
    {title}
  </h1>
  {lead && <p class="mt-3 text-[15.5px] text-muted">{lead}</p>}
</header>
