---
/**
 * DSec-only lifecycle figures. Narrative copy stays in the MDX slots;
 * these fixed schematics deliberately have no scroll state or client code.
 * HTML labels reflow on phones instead of shrinking an SVG's text.
 */
const stages = [
  { id: 'dsec-routing', title: '路由', detail: '身份、选点与准入' },
  { id: 'dsec-layers', title: '拼装', detail: '组合只读环境层' },
  { id: 'dsec-reads', title: '取数', detail: '按需读取镜像' },
  { id: 'dsec-density', title: '运行', detail: '共享与回收内存' },
  { id: 'dsec-suspend', title: '休眠 / 恢复', detail: '抢占时保留状态' },
];
---

<div class="dsec-lifecycle not-prose">
  <nav class="overview" aria-label="沙箱生命周期概览">
    <p class="figure-label">一条请求，五个环节</p>
    <ol>
      {stages.map((stage, i) => (
        <li>
          <a href={`#${stage.id}`}>
            <span class="stage-number">{String(i + 1).padStart(2, '0')}</span>
            <strong>{stage.title}</strong>
            <span class="stage-detail">{stage.detail}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="overview-note">创建时决定环境和节点，运行时按需取数；训练被抢占后，沙箱可以暂停，再从保留的状态恢复。</p>
  </nav>

  <div class="mechanism" id="dsec-routing">
    <div class="copy"><slot name="routing" /></div>
    <figure aria-label="请求依次经过 IAM、放置引擎、apiserver 与 edge；edge 接受后启动，拒绝则换节点重试">
      <figcaption class="figure-label">请求路径 · 谁做决定</figcaption>
      <ol class="request-path">
        <li><strong>IAM</strong><span>认证身份，检查项目配额</span></li>
        <li><strong>放置引擎</strong><span>抽 k 台健康节点，选最闲的一台</span></li>
        <li><strong>apiserver</strong><span>按沙箱 ID 转发到归属 edge</span></li>
        <li><strong>edge</strong><span>节点本地准入，保留最终决定权</span></li>
      </ol>
      <div class="admission">
        <p><strong>接受 ↓</strong><span>挂载存储、配置网络、启动运行时</span></p>
        <p><strong>拒绝 ↶</strong><span>回到放置环节，换节点重试</span></p>
      </div>
      <p class="figure-note">apiserver 无状态；watcher 周期性探测节点健康。</p>
    </figure>
  </div>

  <div class="mechanism" id="dsec-layers">
    <div class="copy"><slot name="layers" /></div>
    <figure aria-label="overlayfs 将工具层、workspace 和基础 OS 合并为只读栈，运行时写入由独立的可写层承接">
      <figcaption class="figure-label">文件系统 · 读写分开，独立更新</figcaption>
      <div class="layer writable">
        <div><strong><span class="write-dot" aria-hidden="true"></span>可写层</strong><code>upperdir</code></div>
        <span>运行时改文件、装依赖 → 写入这里</span>
      </div>
      <div class="readonly-stack">
        <p class="stack-label">只读栈 <code>lowerdir</code><span>独立版本化 · EROFS</span></p>
        <div class="layer"><strong>工具层</strong><span>从 103 个工具层中按需组合</span></div>
        <div class="layer"><strong>workspace</strong><span>任务代码与初始状态</span></div>
        <div class="layer"><strong>基础 OS</strong><span>基础运行环境</span></div>
      </div>
      <div class="rebuild">
        <span>基础镜像升级</span>
        <span>整块镜像 <code>O(m·N)</code></span>
        <span aria-hidden="true">→</span>
        <strong>独立分层 <code>O(m)</code></strong>
      </div>
      <p class="figure-note">dockerd 在创建时组合容器的层栈，改动约 30 行 Go。m 为升级的基础镜像数，N 为 workspace 数；workspace 与工具层无需随基础层重建。</p>
    </figure>
  </div>

  <div class="mechanism" id="dsec-reads">
    <div class="copy"><slot name="reads" /></div>
    <figure aria-label="元数据预取到节点本地，镜像只读数据按需从 3FS 获取，写入留在本地盘；容器与 microVM 使用各自的读取路径">
      <figcaption class="figure-label">数据路径 · 远端读，本地写</figcaption>
      <div class="data-path">
        <div class="data-source"><strong>3FS</strong><span>只读镜像数据</span></div>
        <div class="data-arrow"><span>按需读</span><span aria-hidden="true">→</span></div>
        <div class="data-target"><strong>节点本地</strong><span>预取元数据</span><span>保留运行时写入</span></div>
      </div>
      <dl class="read-paths">
        <div><dt>容器</dt><dd>EROFS 挂载 → 内核预读 → 3FS</dd></div>
        <div><dt>microVM</dt><dd>OverlayBD / ext4 → ublk<br />256 KiB 按需取数，本地盘做二级缓存</dd></div>
      </dl>
      <div class="access-ratio">
        <span>运行时实际触碰的镜像数据</span><strong>4.2–13.3%</strong>
      </div>
      <p class="figure-note">论文 §4.4，按语言采样的容器镜像。此比例描述访问量，不代表所有沙箱启动时只传输这么多数据。</p>
    </figure>
  </div>

  <div class="mechanism" id="dsec-density">
    <div class="copy"><slot name="density" /></div>
    <figure aria-label="microVM 的只读层通过 virtio-pmem 与 DAX 共享宿主页缓存，可写盘通过 DAMON 与气球驱动回收冷页；CPU 调度保护延迟敏感任务">
      <figcaption class="figure-label">资源管理 · 去重、回收与调度</figcaption>
      <div class="memory-sharing">
        <div class="guests"><span>microVM A</span><span>microVM B</span><span>microVM …</span></div>
        <p class="mapping">↓ <code>virtio-pmem / DAX</code> ↓</p>
        <p class="shared-cache"><strong>一份宿主页缓存</strong><span>只读层直接映射，减少客户机重复拷贝</span></p>
      </div>
      <dl class="resource-paths">
        <div><dt>可写盘</dt><dd>DAMON 找冷页 → 内核回收 → 气球驱动向宿主归还空闲页</dd></div>
        <div><dt>CPU</dt><dd><code>SCHED_IDLE</code> 让路；core scheduling 避免挤占延迟敏感任务的 SMT 兄弟线程</dd></div>
      </dl>
      <p class="density-result"><strong>3,200 <span>容器</span></strong><span>或</span><strong>800 <span>microVM</span></strong></p>
      <p class="figure-note">论文 §4.3，生产中单节点稳定运行的观测值；两种后端分别计数，并非同时部署量或容量上限。</p>
    </figure>
  </div>

  <div class="mechanism" id="dsec-suspend">
    <div class="copy"><slot name="suspend" /></div>
    <figure aria-label="GPU 训练被抢占后暂停沙箱：容器换出并回收内存后恢复，microVM 保存内存与执行状态快照后停止进程，恢复时另起进程加载快照">
      <figcaption class="figure-label">状态路径 · 两种后端分别怎么恢复</figcaption>
      <p class="preemption"><strong>GPU 训练被抢占</strong><span>↓ RL 框架暂停关联沙箱</span></p>
      <div class="resume-paths">
        <div>
          <strong class="backend-name">容器</strong>
          <ol>
            <li><strong>暂停</strong><span>docker pause</span></li>
            <li><strong>回收</strong><span>换出内存、回收页面</span></li>
            <li><strong>恢复</strong><span>预取热页后继续执行</span></li>
          </ol>
        </div>
        <div>
          <strong class="backend-name">microVM</strong>
          <ol>
            <li><strong>快照</strong><span>保存内存与执行状态</span></li>
            <li><strong>释放</strong><span>停止 Firecracker 进程</span></li>
            <li><strong>恢复</strong><span>另起进程加载快照</span></li>
          </ol>
        </div>
      </div>
      <p class="figure-note">后续请求触发透明恢复；保留 rollout 的执行状态，无需从命令日志重放。</p>
    </figure>
  </div>
</div>

<style>
  .dsec-lifecycle {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 28px;
    color: var(--color-ink-2);
  }
  p, ol, dl, dd, figure { margin: 0; }
  ol { list-style: none; padding: 0; }
  strong { font-weight: 600; color: var(--color-ink); }
  code { font-family: var(--font-mono); font-size: 0.92em; }
  .figure-label {
    margin-bottom: 16px;
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .overview ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
  .overview li { min-width: 0; position: relative; }
  .overview li + li::before { content: '→'; position: absolute; left: -17px; top: 27px; color: var(--color-muted-2); font-size: 13px; }
  .overview a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; min-height: 76px; }
  .overview a:hover strong { color: var(--color-blue); }
  .stage-number { color: var(--color-muted-2); font-family: var(--font-mono); font-size: 12px; }
  .overview strong { font-size: 16px; }
  .stage-detail { font-size: 12px; color: var(--color-muted); }
  .overview-note { margin-top: 16px; font-size: 13px; color: var(--color-muted); line-height: 1.7; }
  .mechanism {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 40px;
    align-items: start;
    padding-block: 32px;
    border-top: 1px solid var(--color-line-soft);
    scroll-margin-top: 72px;
  }
  .overview + .mechanism { margin-top: 24px; }
  .mechanism:last-child { padding-bottom: 0; }
  .copy, figure { min-width: 0; }
  .copy :global(.stage-label) { margin: 0 0 10px; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); }
  .copy :global(h3) { margin: 0 0 14px; font-size: 22px; line-height: 1.35; font-weight: 600; letter-spacing: -0.02em; color: var(--color-ink); }
  .copy :global(p:not(.stage-label)) { margin: 0; font-size: 15.5px; line-height: 1.75; }
  .copy :global(p + p:not(.stage-label)) { margin-top: 12px; }
  .copy :global(code) { font-family: var(--font-mono); font-size: 0.88em; overflow-wrap: anywhere; }
  figure { font-size: 13px; line-height: 1.6; }
  .figure-note { margin-top: 14px; font-size: 12px; line-height: 1.65; color: var(--color-muted); }
  .request-path { background: var(--color-paper); border-radius: var(--radius); padding: 4px 16px; }
  .request-path li { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 12px; padding-block: 10px; }
  .request-path li + li { border-top: 1px solid var(--color-line); }
  .request-path strong::before { content: '↓'; margin-right: 8px; color: var(--color-muted-2); }
  .request-path li:first-child strong::before { content: '·'; }
  .admission { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
  .admission p { display: grid; gap: 3px; }
  .admission span { color: var(--color-muted); font-size: 12px; }
  .layer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; }
  .layer span { color: var(--color-muted); font-size: 12px; }
  .writable { display: block; background: var(--color-paper); border-radius: var(--radius); margin-bottom: 10px; }
  .writable > div { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .writable > span { display: block; margin-top: 3px; }
  .write-dot { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--color-blue); }
  .readonly-stack { border-left: 2px solid var(--color-line); padding-left: 12px; }
  .stack-label { display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 12px; padding-block: 2px 8px; }
  .stack-label > span { margin-left: auto; color: var(--color-muted); }
  .readonly-stack .layer { background: var(--color-paper); }
  .readonly-stack .layer + .layer { border-top: 3px solid var(--color-white); }
  .rebuild { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin-top: 14px; font-size: 12px; }
  .rebuild > span:first-child { width: 100%; color: var(--color-muted); }
  .data-path { display: grid; grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1.15fr); align-items: center; }
  .data-source, .data-target { display: grid; gap: 4px; padding: 16px; border-radius: var(--radius); background: var(--color-paper); }
  .data-source strong, .data-target strong { font-size: 15px; }
  .data-source span, .data-target span { font-size: 12px; color: var(--color-muted); }
  .data-arrow { display: grid; justify-items: center; color: var(--color-muted); font-size: 12px; }
  .data-arrow > span:last-child { font-size: 22px; }
  .read-paths, .resource-paths { margin-top: 16px; }
  .read-paths > div, .resource-paths > div { display: grid; grid-template-columns: 66px minmax(0, 1fr); gap: 12px; padding-block: 10px; border-bottom: 1px solid var(--color-line-soft); }
  dt { font-weight: 600; color: var(--color-ink); }
  .access-ratio { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; margin-top: 12px; }
  .access-ratio > span { color: var(--color-muted); font-size: 12px; }
  .access-ratio > strong { font-size: 20px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .guests { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .guests > span { text-align: center; background: var(--color-paper); border-radius: var(--radius-sm); padding: 8px 4px; font-size: 12px; }
  .mapping { text-align: center; padding-block: 8px; color: var(--color-muted); font-size: 12px; }
  .shared-cache { display: grid; gap: 3px; text-align: center; padding: 12px; background: var(--color-paper); border-radius: var(--radius); }
  .shared-cache > span { font-size: 12px; color: var(--color-muted); }
  .density-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-top: 14px; }
  .density-result > strong { font-size: 23px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .density-result > span, .density-result strong span { color: var(--color-muted); font-size: 12px; font-weight: 400; }
  .preemption { display: grid; gap: 4px; text-align: center; padding: 12px; background: var(--color-paper); border-radius: var(--radius); }
  .preemption > span { font-size: 12px; color: var(--color-muted); }
  .resume-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
  .backend-name { display: block; margin-bottom: 10px; }
  .resume-paths li { padding-left: 14px; padding-block: 0 12px; border-left: 1px solid var(--color-line); position: relative; }
  .resume-paths li::before { content: ''; position: absolute; width: 5px; height: 5px; left: -3px; top: 8px; border-radius: 50%; background: var(--color-muted-2); }
  .resume-paths li:last-child { padding-bottom: 0; }
  .resume-paths li span { display: block; font-size: 12px; color: var(--color-muted); }
  @media (max-width: 899px) {
    .mechanism { grid-template-columns: 1fr; gap: 24px; }
    .copy :global(h3) { font-size: 21px; }
  }
  @media (max-width: 599px) {
    .dsec-lifecycle { padding: 20px; }
    .overview ol { grid-template-columns: 1fr; gap: 0; }
    .overview a { display: grid; grid-template-columns: 24px 86px minmax(0, 1fr); align-items: center; min-height: 44px; gap: 10px; }
    .overview strong { font-size: 14px; }
    .overview li + li::before { display: none; }
    .stage-detail { font-size: 12px; }
    .overview-note { margin-top: 12px; }
    .mechanism { padding-block: 28px; }
    .request-path { padding-inline: 12px; }
    .request-path li { grid-template-columns: 84px minmax(0, 1fr); gap: 8px; }
    .admission { gap: 12px; }
    .layer { padding-inline: 10px; gap: 10px; }
    .layer > strong { flex-shrink: 0; }
    .layer > span { text-align: right; }
    .stack-label > span { width: 100%; margin-left: 0; }
    .data-path { grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1.15fr); }
    .data-source, .data-target { padding: 12px; }
    .read-paths > div, .resource-paths > div { grid-template-columns: 60px minmax(0, 1fr); gap: 8px; }
    .resume-paths { gap: 16px; }
    .guests { gap: 5px; }
  }
</style>
