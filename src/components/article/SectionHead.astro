---
/**
 * Standard section heading inside a <Section>: optional kicker line,
 * ink H2, optional supporting line.
 * Pass `index` ("01"…"13") to render a liquid-glass index pill that
 * mirrors the numbering in the floating TOC rail.
 */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  center?: boolean;
  /**
   * Short one-line name used by the floating TOC. On a numbered head
   * (`index` set) the kicker doubles as this by convention — keep such
   * kickers to a short noun phrase (~6 CJK glyphs). Explicit `toc`
   * overrides it; the long h2 title always stays as the page heading.
   */
  toc?: string;
  index?: string;
}

const { kicker, title, lead, center = false, toc, index } = Astro.props;
const tocLabel = toc ?? (index ? kicker : undefined);
---

<header class:list={['mb-7', center && 'mx-auto max-w-[680px] text-center']}>
  <div class:list={['flex items-center gap-2.5', center && 'justify-center']}>
    {index && (
      <span class="section-index" aria-hidden="true">{index}</span>
    )}
    {kicker && <p class="eyebrow !mt-0">{kicker}</p>}
  </div>
  <h2
    data-toc-label={tocLabel}
    data-toc-index={index}
    class="mt-3 text-[clamp(22px,2.8vw,28px)] font-semibold leading-[1.15] tracking-[-0.022em] text-ink"
  >
    {title}
  </h2>
  {lead && <p class="mt-3 max-w-[640px] leading-relaxed text-muted text-[14.5px]">{lead}</p>}
</header>
