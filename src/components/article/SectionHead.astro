---
/**
 * Standard section heading inside a <Section>: gray uppercase kicker,
 * ink H2, optional supporting line.
 */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  center?: boolean;
}

const { kicker, title, lead, center = false } = Astro.props;
---

<header class:list={['mb-7', center && 'mx-auto max-w-[680px] text-center']}>
  {kicker && <p class="eyebrow">{kicker}</p>}
  <h2
    class="mt-3 text-[clamp(22px,2.8vw,28px)] font-semibold leading-[1.15] tracking-[-0.022em] text-ink"
  >
    {title}
  </h2>
  {lead && <p class="mt-3 max-w-[640px] text-[14.5px] leading-relaxed text-muted">{lead}</p>}
</header>
