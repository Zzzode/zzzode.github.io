---
/**
 * Time-rail schedule for concrete itineraries. Two item kinds:
 *  - phase band: { band, sub? } — full-width dark label grouping rows
 *  - row: { time, duration?, tag?, title, body? }
 * Rendered as a scannable clock: bold time on the left, continuous rail
 * with dots, content card on the right.
 */
interface ScheduleRow {
  time: string;
  duration?: string;
  tag?: string;
  title: string;
  body?: string;
}
interface ScheduleBand {
  band: string;
  sub?: string;
}
type Item = ScheduleRow | ScheduleBand;

const isBand = (i: Item): i is ScheduleBand => 'band' in i;

interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="not-prose">
  {
    items.map((item) =>
      isBand(item) ? (
        <li class="mb-3 mt-7 first:mt-0">
          <div class="flex items-baseline gap-3 rounded-2xl bg-ink px-5 py-2.5">
            <span class="text-[12.5px] font-semibold tracking-wide text-white">{item.band}</span>
            {item.sub && <span class="text-[11.5px] text-white/55">{item.sub}</span>}
          </div>
        </li>
      ) : (
        <li class="grid grid-cols-[64px_22px_1fr] items-stretch">
          <div class="pb-4 pr-2 pt-[18px] text-right">
            <p class="text-[13px] font-bold leading-tight text-blue">{item.time}</p>
            {item.duration && <p class="mt-0.5 text-[10.5px] leading-tight text-muted-2">{item.duration}</p>}
          </div>
          <div class="relative flex justify-center">
            <span class="absolute top-0 bottom-0 w-px bg-line" />
            <span class="relative mt-[21px] h-[9px] w-[9px] shrink-0 rounded-full border-[3px] border-blue bg-white" />
          </div>
          <div class="pb-3">
            <div class="rounded-2xl border border-line-soft bg-white px-5 py-3.5">
              <div class="flex items-baseline gap-2.5">
                <h4 class="text-[14.5px] font-semibold leading-snug text-ink">{item.title}</h4>
                {item.tag && (
                  <span class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.08em] text-muted-2">
                    {item.tag}
                  </span>
                )}
              </div>
              {item.body && <p class="mt-1.5 text-[12.8px] leading-[1.7] text-muted">{item.body}</p>}
            </div>
          </div>
        </li>
      )
    )
  }
</ol>
