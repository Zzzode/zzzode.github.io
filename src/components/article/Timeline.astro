---
/**
 * Horizontal rail timeline: hairline rail behind ringed nodes.
 * Any number of nodes: on md+ the rail becomes a horizontally scroll-snapping
 * strip of fixed-width cards; below md it collapses to a vertical list.
 */
interface Node {
  year: string;
  title: string;
  body?: string;
}

interface Props {
  nodes: Node[];
}

const { nodes } = Astro.props;
---

<ol class="not-prose timeline grid grid-cols-1 gap-5 md:flex md:gap-3 md:overflow-x-auto md:pb-2.5 md:snap-x md:snap-proximity [scrollbar-width:thin] [scrollbar-color:var(--color-line)_transparent] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-line [&::-webkit-scrollbar-thumb]:transition-colors hover:[&::-webkit-scrollbar-thumb]:bg-muted-2">
  {
    nodes.map((node, i) => (
      <li
        class:list={[
          'relative md:relative md:min-w-[168px] md:snap-start md:rounded-[14px] md:border md:border-line-soft md:bg-white md:px-3.5 md:pb-3.5 md:pt-9',
          i < nodes.length - 1 && 'md:flex-1',
        ]}
      >
        <span
          class="absolute left-0 top-[2px] h-3 w-3 rounded-full border-[3px] border-blue bg-white md:left-3.5 md:top-[9px]"
        />
        {
          /* on mobile a vertical hairline joins consecutive nodes */
        }
        {
          i < nodes.length - 1 && (
            <span
              class="absolute left-[5.5px] top-[16px] h-[calc(100%+12px)] w-px bg-line-soft md:hidden"
              aria-hidden="true"
            />
          )
        }
        <p class="pl-6 text-[11px] font-semibold text-blue md:pl-0">{node.year}</p>
        <h4 class="mt-1 pl-6 text-[13px] font-semibold leading-[1.4] text-ink md:pl-0">
          {node.title}
        </h4>
        {node.body && (
          <p class="mt-1 pl-6 text-[12px] leading-[1.6] text-muted md:pl-0">{node.body}</p>
        )}
      </li>
    ))
  }
</ol>
