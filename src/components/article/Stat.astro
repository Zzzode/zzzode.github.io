---
/**
 * One key-number cell for <StatGrid>. `unit` renders smaller after the number.
 * Optional count-up (article script, motion only): pass numeric `count` plus
 * `countPrefix` / `countSuffix` / `countDecimals`; server output always shows
 * the final value verbatim, so no-JS and reduced-motion render the truth.
 */
interface Props {
  value: string;
  unit?: string;
  label?: string;
  count?: number;
  countPrefix?: string;
  countSuffix?: string;
  countDecimals?: number;
  /** dark emphasis tile (used inside a tile StatGrid) */
  dark?: boolean;
}

const {
  value,
  unit,
  label,
  count,
  countPrefix = '',
  countSuffix = '',
  countDecimals = 0,
  dark = false,
} = Astro.props;
---

<div
  class:list={[
    'bg-white px-5 py-6',
    dark && 'stat-cell-dark bg-ink',
  ]}
>
  <dt
    class:list={[
      'stat-num text-[26px] font-semibold leading-[1.1] tracking-[-0.02em]',
      dark ? 'text-paper' : 'text-ink',
    ]}
  >
    {
      typeof count === 'number' ? (
        <span
          data-count={count}
          data-prefix={countPrefix}
          data-suffix={countSuffix}
          data-decimals={countDecimals}
          >{countPrefix}{value}{countSuffix}</span
        >
      ) : (
        value
      )
    }
    {unit && <small class:list={['ml-1 text-[13px] font-semibold', dark ? 'text-[#a1a1a6]' : 'text-muted']}>{unit}</small>}
  </dt>
  {label && <dd class:list={['mt-1.5 text-[12px] leading-[1.5]', dark ? 'text-[#c7c7cc]' : 'text-muted']}>{label}</dd>}
</div>
