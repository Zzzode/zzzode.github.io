---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../HomeHero.astro';
import { getCollection } from 'astro:content';
import { type Lang, t } from '../../i18n/ui';
import { localeOfId } from '../../lib/content';
import type { Entry } from '../../lib/entries';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const raw = await getCollection('posts', (entry) => localeOfId(entry.id) === lang);
const totalSources = raw.reduce((n, e) => n + ((e.data.sources as { url: string }[] | undefined)?.length ?? 0), 0);

// Editorial curation, independent of same-date glob order.
const posts: Entry[] = [...raw]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((item) => ({
    title: item.data.title,
    meta:
      lang === 'zh'
        ? `${item.data.date.getFullYear()}年${item.data.date.getMonth() + 1}月${item.data.date.getDate()}日`
        : item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    excerpt: item.data.excerpt,
    tags: item.data.tags,
    href: `${prefix}/posts/${item.id.replace(/^(zh|en)\//, '')}/`,
  }));

const slugOf = (e: Entry) => e.href.split('/').filter(Boolean).pop() ?? '';
const bySlug = new Map(posts.map((e) => [slugOf(e), e]));

const featureSlug = '2026-09-23-beijing-universal-1half-day-playbook';
const pickSlugs = [
  '2026-09-23-ai-and-compilers-survey',
  '2026-09-23-ai-glasses-industry-chain',
  '2026-09-23-nvidia-h200-china-verification',
];
const picked = new Set([featureSlug, ...pickSlugs]);
const feature = bySlug.get(featureSlug);
const [lead, ...secondaries] = pickSlugs.map((s) => bySlug.get(s)).filter(Boolean) as Entry[];
const indexPosts = posts.filter((e) => !picked.has(slugOf(e))).slice(0, 10);

interface Topic {
  key: 'agents' | 'models' | 'languages' | 'industry';
  slugs: string[];
}
const topics: Topic[] = [
  {
    key: 'agents',
    slugs: [
      '2026-09-23-claude-code-architecture',
      '2026-09-23-e2b-sandbox-infra',
      '2026-09-23-flue-agent-harness',
      '2026-09-23-nanoclaw-agent',
      '2026-09-23-grokbot-openclaw-agent-forms',
      '2026-09-23-tradingagents',
      '2026-09-22-mimo-v26-open-rl',
    ],
  },
  {
    key: 'models',
    slugs: [
      '2026-09-23-jev-system1',
      '2026-09-23-laya-decision-model',
      '2026-09-23-bert-diffusion-llada',
    ],
  },
  {
    key: 'languages',
    slugs: [
      '2026-09-23-ai-and-compilers-survey',
      '2026-09-23-kotlin-k2-fir-interop',
      '2026-09-23-skip-language',
      '2026-09-23-gson-yymodel-serialization',
      '2026-09-23-rustc-query-incremental',
      '2026-09-23-v8-jvm-instance-models',
      '2026-09-23-edgejs-inprocess-dotnet',
    ],
  },
  {
    key: 'industry',
    slugs: [
      '2026-09-23-ai-glasses-industry-chain',
      '2026-09-23-nvidia-h200-china-verification',
      '2026-09-23-ai-org-structure',
    ],
  },
];
const topicCards = topics.map((topic, i) => {
  const entries = topic.slugs.map((s) => bySlug.get(s)).filter(Boolean) as Entry[];
  return { ...topic, index: String(i + 1).padStart(2, '0'), entries };
});

const stats = [
  { value: String(posts.length), label: t(lang, 'home.band.words') },
  { value: '4', label: t(lang, 'home.band.lines') },
  { value: String(totalSources), label: t(lang, 'home.band.sources') },
  { value: '0 JS', label: t(lang, 'home.band.zerojs') },
];
---

<BaseLayout lang={lang} bare title={t(lang, 'home.title')}>
  <HomeHero lang={lang} />

  {
    posts.length === 0 ? (
      <section class="bg-paper">
        <div class="container-page py-20">
          <div class="rounded-[18px] bg-white px-8 py-20 text-center">
            <p class="text-[14.5px] text-muted">{t(lang, 'home.latest.empty')}</p>
          </div>
        </div>
      </section>
    ) : (
      <>
        {/* Lead feature — the one post with a real map image */}
        {feature && (
          <section class="bg-white">
            <div class="container-page pb-14 sm:pb-16">
              <a href={feature.href} class="group block">
                <div class="overflow-hidden rounded-[28px] border border-line-soft bg-paper">
                  <img
                    src="/images/ubr/route-map.jpg"
                    alt="北京环球影城官方插画地图，上面画着三天的步行路线、节点编号与正餐位置"
                    class="block max-h-[560px] w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.015]"
                    loading="eager"
                  />
                </div>
                <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:items-end sm:justify-between">
                  <div class="max-w-[760px]">
                    <p class="eyebrow text-blue">{t(lang, 'home.featured')}</p>
                    <h2
                      class="mt-3 text-[clamp(26px,3.4vw,40px)] font-semibold leading-[1.12] tracking-[-0.03em] text-ink transition-colors group-hover:text-blue"
                    >
                      {feature.title}
                    </h2>
                    {feature.excerpt && (
                      <p class="mt-4 text-[15px] leading-relaxed text-muted sm:text-[16px]">
                        {feature.excerpt}
                      </p>
                    )}
                  </div>
                  <p class="shrink-0 text-[13px] text-muted-2">{feature.meta}</p>
                </div>
              </a>
            </div>
          </section>
        )}

        {/* Editor's picks + numbered index */}
        <section class="bg-paper">
          <div class="container-page py-14 sm:py-16">
            <div class="mb-5 flex items-baseline justify-between gap-4">
              <h2 class="text-[clamp(22px,2.6vw,28px)] font-semibold tracking-[-0.02em] text-ink">
                {t(lang, 'home.recent')}
              </h2>
              <a
                href={`${prefix}/posts/`}
                class="inline-flex shrink-0 items-center gap-1 text-[14.5px] text-blue hover:underline underline-offset-4"
              >
                {t(lang, 'home.archive')}
                <span aria-hidden="true">›</span>
              </a>
            </div>

            <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
              {lead && (
                <a
                  href={lead.href}
                  class="group flex flex-col rounded-[18px] bg-white px-7 py-8 sm:px-9 sm:py-10"
                >
                  <p class="text-[12.5px] text-muted-2">{lead.meta}</p>
                  <h3
                    class="mt-3 text-[clamp(21px,2.4vw,27px)] font-semibold leading-[1.16] tracking-[-0.022em] text-ink transition-colors group-hover:text-blue"
                  >
                    {lead.title}
                  </h3>
                  {lead.excerpt && (
                    <p class="mt-4 text-[14px] leading-relaxed text-muted">{lead.excerpt}</p>
                  )}
                </a>
              )}
              <div class="grid grid-cols-1 gap-3">
                {
                  secondaries.map((post) => (
                    <a
                      href={post.href}
                      class="group flex flex-1 flex-col justify-center rounded-[18px] bg-white px-7 py-6"
                    >
                      <p class="text-[12px] text-muted-2">{post.meta}</p>
                      <h3
                        class="mt-2 text-[17.5px] font-semibold leading-snug tracking-[-0.015em] text-ink transition-colors group-hover:text-blue"
                      >
                        {post.title}
                      </h3>
                      {post.excerpt && (
                        <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-muted">
                          {post.excerpt}
                        </p>
                      )}
                    </a>
                  ))
                }
              </div>
            </div>

            {/* Numbered index: ten more at a glance */}
            <ol class="mt-3 overflow-hidden rounded-[18px] bg-white md:columns-2 md:gap-0">
              {
                indexPosts.map((post, i) => (
                  <li class="break-inside-avoid border-b border-line-soft last:border-b-0 md:[&:nth-child(odd)]:border-r md:[&:nth-last-child(2)]:border-b-0">
                    <a
                      href={post.href}
                      class="group flex items-baseline gap-4 px-6 py-4 transition-colors hover:bg-paper sm:px-7"
                    >
                      <span class="w-7 shrink-0 font-mono text-[12px] tabular-nums text-muted-2">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <span class="flex-1 text-[15px] font-medium leading-snug tracking-[-0.01em] text-ink transition-colors group-hover:text-blue">
                        {post.title}
                      </span>
                      <span class="hidden shrink-0 text-[12px] text-muted-2 sm:block">{post.meta}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        {/* Topic series */}
        <section class="bg-white">
          <div class="container-page py-14 sm:py-16">
            <div class="mb-6 flex items-baseline justify-between gap-4">
              <div>
                <h2 class="text-[clamp(22px,2.6vw,28px)] font-semibold tracking-[-0.02em] text-ink">
                  {t(lang, 'home.topics')}
                </h2>
                <p class="mt-1.5 text-[14px] text-muted">{t(lang, 'home.topics.sub')}</p>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {
                topicCards.map((topic) => (
                  <a
                    href={`${prefix}/posts/`}
                    class="group flex h-full flex-col rounded-[18px] border border-line-soft bg-white p-6 transition-colors hover:border-blue"
                  >
                    <div class="flex items-baseline justify-between">
                      <span class="font-mono text-[12px] tabular-nums text-muted-2">{topic.index}</span>
                      <span class="rounded-full bg-paper px-2.5 py-0.5 text-[11.5px] font-medium text-ink-2">
                        {topic.entries.length}
                      </span>
                    </div>
                    <h3
                      class="mt-4 text-[17.5px] font-semibold leading-snug tracking-[-0.015em] text-ink transition-colors group-hover:text-blue"
                    >
                      {t(lang, `topic.${topic.key}`)}
                    </h3>
                    <p class="mt-2 text-[12.5px] leading-relaxed text-muted">
                      {t(lang, `topic.${topic.key}.desc`)}
                    </p>
                    <ul class="mt-4 space-y-1.5 border-t border-line-soft pt-4">
                      {topic.entries.slice(0, 2).map((e) => (
                        <li class="truncate text-[12px] text-muted-2">{e.title}</li>
                      ))}
                    </ul>
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        {/* Archive band */}
        <section class="bg-white">
          <div class="container-page pb-20 sm:pb-24">
            <div class="overflow-hidden rounded-[28px] bg-ink px-7 py-9 sm:px-12 sm:py-11">
              <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
                <dl class="grid grid-cols-2 gap-x-10 gap-y-6 sm:grid-cols-4">
                  {
                    stats.map((s) => (
                      <div>
                        <dt class="order-2 mt-1.5 text-[12px] leading-snug text-white/55">{s.label}</dt>
                        <dd class="order-1 text-[clamp(28px,3vw,38px)] font-semibold tracking-[-0.02em] text-white">
                          {s.value}
                        </dd>
                      </div>
                    ))
                  }
                </dl>
                <div class="flex shrink-0 flex-col items-start gap-2 lg:items-end">
                  <a
                    href={`${prefix}/posts/`}
                    class="inline-flex items-center gap-1.5 rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-ink transition-opacity hover:opacity-90"
                  >
                    {t(lang, 'home.archive')}
                    <span aria-hidden="true">›</span>
                  </a>
                  <a
                    href="/rss.xml"
                    class="text-[12.5px] text-white/55 underline-offset-4 hover:text-white hover:underline"
                  >
                    RSS
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
