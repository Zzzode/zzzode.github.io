---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../HomeHero.astro';
import { getCollection } from 'astro:content';
import { type Lang, t } from '../../i18n/ui';
import { localeOfId } from '../../lib/content';
import type { Entry } from '../../lib/entries';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const raw = await getCollection('posts', (entry) => localeOfId(entry.id) === lang);
const totalSources = raw.reduce((n, e) => n + ((e.data.sources as { url: string }[] | undefined)?.length ?? 0), 0);

// Editorial curation, independent of same-date glob order.
const posts: Entry[] = [...raw]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((item) => ({
    title: item.data.title,
    meta:
      lang === 'zh'
        ? `${item.data.date.getFullYear()}年${item.data.date.getMonth() + 1}月${item.data.date.getDate()}日`
        : item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    excerpt: item.data.excerpt,
    tags: item.data.tags,
    href: `${prefix}/posts/${item.id.replace(/^(zh|en)\//, '')}/`,
  }));

const slugOf = (e: Entry) => (e.href ?? '').split('/').filter(Boolean).pop() ?? '';
const bySlug = new Map(posts.map((e) => [slugOf(e), e]));

const featureSlug = '2026-09-23-ai-and-compilers-survey';
const pickSlugs = [
  '2026-09-23-claude-code-architecture',
  '2026-09-22-mimo-v26-open-rl',
  '2026-09-23-jev-system1',
];
const picked = new Set([featureSlug, ...pickSlugs]);
const feature = bySlug.get(featureSlug);
const featureTags = (feature?.tags ?? []).slice(0, 5);
const pickItems = pickSlugs
  .map((s, i) => ({ post: bySlug.get(s), num: String(i + 1).padStart(2, '0'), lead: i === 0 }))
  .filter((x): x is { post: Entry; num: string; lead: boolean } => Boolean(x.post));
const indexPosts = posts.filter((e) => !picked.has(slugOf(e))).slice(0, 10);
const indexItems = indexPosts.map((post, i) => ({
  post,
  num: String(i + pickItems.length + 1).padStart(2, '0'),
}));

interface Topic {
  key: 'agents' | 'models' | 'languages' | 'industry';
  slugs: string[];
}
const topics: Topic[] = [
  {
    key: 'agents',
    slugs: [
      '2026-09-23-claude-code-architecture',
      '2026-09-23-e2b-sandbox-infra',
      '2026-09-23-flue-agent-harness',
      '2026-09-23-nanoclaw-agent',
      '2026-09-23-grokbot-openclaw-agent-forms',
      '2026-09-23-tradingagents',
      '2026-09-22-mimo-v26-open-rl',
    ],
  },
  {
    key: 'models',
    slugs: [
      '2026-09-23-jev-system1',
      '2026-09-23-laya-decision-model',
      '2026-09-23-bert-diffusion-llada',
    ],
  },
  {
    key: 'languages',
    slugs: [
      '2026-09-23-ai-and-compilers-survey',
      '2026-09-23-kotlin-k2-fir-interop',
      '2026-09-23-skip-language',
      '2026-09-23-gson-yymodel-serialization',
      '2026-09-23-rustc-query-incremental',
      '2026-09-23-v8-jvm-instance-models',
      '2026-09-23-edgejs-inprocess-dotnet',
    ],
  },
  {
    key: 'industry',
    slugs: [
      '2026-09-23-ai-glasses-industry-chain',
      '2026-09-23-nvidia-h200-china-verification',
      '2026-09-23-ai-org-structure',
    ],
  },
];
const topicCards = topics.map((topic, i) => {
  const entries = topic.slugs.map((s) => bySlug.get(s)).filter(Boolean) as Entry[];
  return { ...topic, index: String(i + 1).padStart(2, '0'), entries };
});

const colophon = [
  `${posts.length} ${t(lang, 'home.meta.words')}`,
  `${topics.length} ${t(lang, 'home.meta.threads')}`,
  `${totalSources} ${t(lang, 'home.meta.sources')}`,
  t(lang, 'home.meta.zerojs'),
].join('  ·  ');
---

<BaseLayout lang={lang} bare title={t(lang, 'home.title')}>
  <HomeHero lang={lang} />

  {
    posts.length === 0 ? (
      <section class="bg-paper">
        <div class="container-page py-20">
          <div class="rounded-[18px] bg-white px-8 py-20 text-center">
            <p class="text-[14.5px] text-muted">{t(lang, 'home.latest.empty')}</p>
          </div>
        </div>
      </section>
    ) : (
      <>
        {/* Lead story — magazine opener, type and hairlines only */}
        {feature && (
          <section class="bg-white">
            <div class="container-page">
              <a href={feature.href} class="group block border-t border-line py-10 sm:py-14">
                <div class="grid gap-7 lg:grid-cols-[190px_1fr] lg:gap-14">
                  <aside class="lg:pt-1.5">
                    <p class="eyebrow">{t(lang, 'home.featured')}</p>
                    <p class="mt-3 text-[12.5px] text-muted-2">{feature.meta}</p>
                  </aside>
                  <div>
                    <h2
                      class="max-w-[860px] text-[clamp(29px,3.7vw,46px)] font-semibold leading-[1.1] tracking-[-0.032em] text-ink transition-colors duration-200 group-hover:text-blue"
                    >
                      {feature.title}
                    </h2>
                    {feature.excerpt && (
                      <p class="mt-5 max-w-[720px] text-[15.5px] leading-[1.7] text-muted sm:text-[16.5px]">
                        {feature.excerpt}
                      </p>
                    )}
                    {featureTags.length > 0 && (
                      <p class="mt-7 text-[12.5px] leading-relaxed text-muted-2">
                        {featureTags.join('  ·  ')}
                      </p>
                    )}
                    <span class="mt-5 inline-flex items-center gap-1 text-[14.5px] font-medium text-blue">
                      {t(lang, 'home.read')}
                      <span aria-hidden="true">›</span>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </section>
        )}

        {/* Editor's picks — hairline editorial rows */}
        <section class="bg-paper">
          <div class="container-page py-14 sm:py-16">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-[clamp(21px,2.5vw,26px)] font-semibold tracking-[-0.022em] text-ink">
                {t(lang, 'home.recent')}
              </h2>
              <a
                href={`${prefix}/posts/`}
                class="inline-flex shrink-0 items-center gap-1 text-[14px] font-medium text-blue transition-colors hover:text-blue-hover"
              >
                {t(lang, 'home.archive')}
                <span aria-hidden="true">›</span>
              </a>
            </div>

            <div class="mt-4 border-t border-line">
              {
                pickItems.map(({ post, num, lead }, i) => (
                  <a
                    href={post.href}
                    class:list={[
                      'group grid items-baseline gap-x-7 gap-y-2 py-6 sm:py-7 lg:grid-cols-[40px_1fr_auto]',
                      i === pickItems.length - 1 ? '' : 'border-b border-line',
                    ]}
                  >
                    <span class="hidden font-mono text-[12px] tabular-nums text-muted-2 lg:block">
                      {num}
                    </span>
                    <div>
                      <p class="mb-2 text-[12px] text-muted-2 lg:hidden">{post.meta}</p>
                      <h3
                        class:list={[
                          'font-semibold tracking-[-0.02em] text-ink transition-colors duration-200 group-hover:text-blue',
                          lead
                            ? 'text-[clamp(21px,2.4vw,27px)] leading-[1.18]'
                            : 'text-[18.5px] leading-snug sm:text-[20px]',
                        ]}
                      >
                        {post.title}
                      </h3>
                      {post.excerpt && (
                        <p
                          class:list={[
                            'mt-2.5 leading-relaxed text-muted',
                            lead
                              ? 'max-w-[680px] text-[14px] sm:text-[15px]'
                              : 'line-clamp-2 max-w-[620px] text-[13.5px]',
                          ]}
                        >
                          {post.excerpt}
                        </p>
                      )}
                    </div>
                    <span class="hidden text-[12.5px] text-muted-2 lg:block">{post.meta}</span>
                  </a>
                ))
              }
            </div>

            {/* Numbered index — one continuous hairline system across both columns.
                No top margin: the rule above 04/05 must sit the same py-7 distance
                below 03 as the rules between the pick rows. */}
            <ol class="grid md:grid-cols-2">
              {
                indexItems.map(({ post, num }) => (
                  <li
                    class="border-t border-line md:[&:nth-child(even)]:pl-6 md:[&:nth-child(odd)]:pr-6"
                  >
                    <a href={post.href} class="group flex items-baseline gap-4 py-3.5">
                      <span class="w-6 shrink-0 font-mono text-[11.5px] tabular-nums text-muted-2">
                        {num}
                      </span>
                      <span class="flex-1 text-[14.5px] font-medium leading-snug tracking-[-0.008em] text-ink transition-colors duration-200 group-hover:text-blue">
                        {post.title}
                      </span>
                      <span class="hidden shrink-0 text-[12px] text-muted-2 sm:block">{post.meta}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        {/* Topic threads — quiet text index divided by rules */}
        <section class="bg-white">
          <div class="container-page py-14 sm:py-16">
            <h2 class="text-[clamp(21px,2.5vw,26px)] font-semibold tracking-[-0.022em] text-ink">
              {t(lang, 'home.topics')}
            </h2>
            <p class="mt-2 text-[14px] text-muted">{t(lang, 'home.topics.sub')}</p>

            <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-0">
              {
                topicCards.map((topic) => (
                  <a
                    href={`${prefix}/posts/`}
                    class="group flex min-w-0 h-full flex-col lg:border-l lg:border-line-soft lg:px-8 lg:first:border-l-0 lg:first:pl-0"
                  >
                    <div class="flex items-baseline justify-between gap-2.5">
                      <span class="font-mono text-[12px] tabular-nums text-muted-2">
                        {topic.index}
                      </span>
                      <span class="text-[12px] text-muted-2">
                        {topic.entries.length} {t(lang, 'home.topic.unit')}
                      </span>
                    </div>
                    <h3
                      class="mt-3.5 text-[17.5px] font-semibold leading-snug tracking-[-0.015em] text-ink transition-colors duration-200 group-hover:text-blue"
                    >
                      {t(lang, `topic.${topic.key}`)}
                    </h3>
                    <p class="mt-2 text-[12.5px] leading-relaxed text-muted">
                      {t(lang, `topic.${topic.key}.desc`)}
                    </p>
                    <ul class="mt-5 w-full space-y-2 border-t border-line-soft pt-4">
                      {topic.entries.slice(0, 2).map((e) => (
                        <li class="truncate text-[12px] text-muted-2 transition-colors group-hover:text-ink-2">
                          {e.title}
                        </li>
                      ))}
                    </ul>
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        {/* Colophon — one quiet meta line, no dark stat slab */}
        <section class="bg-paper">
          <div class="container-page py-12 sm:py-14">
            <div class="flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p class="eyebrow">{t(lang, 'home.meta.eyebrow')}</p>
                <p class="mt-3 text-[14px] leading-relaxed text-muted">{colophon}</p>
              </div>
              <div class="flex shrink-0 items-center gap-7">
                <a
                  href={`${prefix}/posts/`}
                  class="inline-flex items-center gap-1 text-[14.5px] font-medium text-blue transition-colors hover:text-blue-hover"
                >
                  {t(lang, 'home.archive')}
                  <span aria-hidden="true">›</span>
                </a>
                <a
                  href="/rss.xml"
                  class="text-[13px] text-muted-2 underline-offset-4 transition-colors hover:text-blue hover:underline"
                >
                  RSS
                </a>
              </div>
            </div>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
