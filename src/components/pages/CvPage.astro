---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang, t } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const sections = ['education', 'experience', 'teaching', 'service'] as const;
---

<BaseLayout lang={lang} title="CV">
  <header class="mb-10">
    <p class="eyebrow">{t(lang, 'cv.eyebrow')}</p>
    <h1
      class="mt-3 text-[clamp(30px,4vw,40px)] font-semibold tracking-[-0.025em] text-ink"
    >
      Zzzode
    </h1>
    <p class="mt-3 text-[14.5px] text-muted">{t(lang, 'cv.intro')}</p>
  </header>

  <div class="space-y-12">
    {
      sections.map((section) => (
        <section>
          <h2 class="text-[20px] font-semibold tracking-[-0.015em] text-ink">
            {t(lang, `cv.${section}`)}
          </h2>
          <p class="mt-3 rounded-[18px] bg-paper px-6 py-6 text-[14px] text-muted">
            {t(lang, 'cv.placeholder')}
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>
