---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../article/Sources.astro';
import { type Lang, t } from '../../i18n/ui';
import { formatDate, isoDate } from '../../lib/format';
import { getLocalized, slugOfId } from '../../lib/content';
import { readingMinutes } from '../../lib/reading-time';

interface Props {
  lang: Lang;
  post: CollectionEntry<'posts'>;
  counterpart: CollectionEntry<'posts'> | undefined;
}

const { lang, post, counterpart } = Astro.props;
const { Content } = await render(post);
const prefix = lang === 'en' ? '/en' : '';
const alternatePath = counterpart
  ? `${lang === 'zh' ? '/en' : ''}/posts/${slugOfId(post.id)}/`
  : null;

const distilled = post.data.kind === 'distilled';
const iso = isoDate(post.data.date);
const minutes = readingMinutes(post.body);

// Chronological neighbors within the locale (list order: newest first).
const ordered = (await getLocalized('posts', lang)).filter((e) => !e.data.draft);
const index = ordered.findIndex((e) => e.id === post.id);
const newer = index > 0 ? ordered[index - 1] : undefined;
const older = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : undefined;
const hrefOf = (e: CollectionEntry<'posts'>) => `${prefix}/posts/${slugOfId(e.id)}/`;
---

<BaseLayout
  lang={lang}
  title={distilled ? post.data.title : undefined}
  description={post.data.excerpt}
  alternatePath={alternatePath}
>
  <!-- TOC rail populated by the article script at wide widths -->
  <div data-toc aria-hidden="false"></div>

  <!-- Liquid-glass refraction: soft noise lens applied to the TOC's backdrop
       in Chromium; other browsers fall back to a light blur. -->
  <svg aria-hidden="true" focusable="false" width="0" height="0" class="absolute h-0 w-0">
    <filter
      id="article-liquid-glass"
      x="-40%"
      y="-20%"
      width="180%"
      height="140%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.008 0.008"
        numOctaves="2"
        seed="92"
        result="noise"
      >
      </feTurbulence>
      <feGaussianBlur in="noise" stdDeviation="2" result="blurred"></feGaussianBlur>
      <feDisplacementMap
        in="SourceGraphic"
        in2="blurred"
        scale="34"
        xChannelSelector="R"
        yChannelSelector="G"
      >
      </feDisplacementMap>
    </filter>
  </svg>

  <article
    data-article
    data-pagefind-body
    class:list={[
      distilled
        ? 'distilled mx-auto w-full max-w-[1080px] px-1 sm:px-2'
        : 'note mx-auto max-w-[760px]',
    ]}
  >
    {
      !distilled && (
        <header class="reveal mb-8">
          <p class="eyebrow">WRITING</p>
          <h1
            class="mt-3 text-[clamp(28px,4vw,38px)] font-semibold leading-[1.12] tracking-[-0.025em] text-ink"
          >
            {post.data.title}
          </h1>
          <p class="mt-3 text-[13px] text-muted">
            <time datetime={iso}>{formatDate(post.data.date, lang)}</time>
            <span class="mx-2 text-line">·</span>
            <span>{minutes} {t(lang, 'post.minutes')}</span>
            {
              post.data.updated && (
                <span class="ml-3 text-muted-2">
                  {t(lang, 'post.updated')}
                  <time datetime={isoDate(post.data.updated)}>
                    {formatDate(post.data.updated, lang)}
                  </time>
                </span>
              )
            }
          </p>
          {
            post.data.tags.length > 0 && (
              <ul class="mt-3.5 flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <li>
                    <a
                      href={`${prefix}/posts/tags/${encodeURIComponent(tag)}/`}
                      class="inline-block rounded-full border border-line px-2.5 py-0.5 text-[11.5px] text-ink-2 transition-colors hover:border-blue hover:text-blue"
                    >
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>
      )
    }

    <div class:list={[distilled ? '' : 'prose max-w-none']}>
      <Content />
    </div>

    {
      distilled && (post.data.sources?.length ?? 0) > 0 && (
        <Sources sources={post.data.sources ?? []} date={iso} />
      )
    }

    {
      !counterpart && (
        <p
          class:list={[
            'border-t border-line-soft pt-6 text-[12.5px] text-muted-2',
            distilled ? 'mt-10' : 'mt-12',
          ]}
        >
          {t(lang, 'post.untranslated')}
        </p>
      )
    }
  </article>

  {
    (newer || older) && (
      <nav
        aria-label={t(lang, 'post.adjacent')}
        class:list={[
          'mx-auto grid border-t border-line sm:grid-cols-2',
          distilled ? 'mt-10 max-w-[1080px]' : 'mt-12 max-w-[760px]',
        ]}
      >
        {newer ? (
          <a href={hrefOf(newer)} class="group py-5 sm:pr-6 sm:text-left">
            <span class="block text-[11.5px] uppercase tracking-[0.1em] text-muted-2">
              ‹ {t(lang, 'post.newer')}
            </span>
            <span class="mt-1 block truncate text-[14px] font-medium text-ink transition-colors group-hover:text-blue">
              {newer.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}
        {older && (
          <a
            href={hrefOf(older)}
            class="group border-t border-line-soft py-5 sm:border-l sm:border-t-0 sm:border-line sm:pl-6 sm:text-right"
          >
            <span class="block text-[11.5px] uppercase tracking-[0.1em] text-muted-2">
              {t(lang, 'post.older')} ›
            </span>
            <span class="mt-1 block truncate text-[14px] font-medium text-ink transition-colors group-hover:text-blue">
              {older.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }

  <script>
    import '../../scripts/article';
  </script>
</BaseLayout>
