---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { en: 'EDUCATION', title: '教育经历' },
  { en: 'EXPERIENCE', title: '工作经历' },
  { en: 'TEACHING', title: '教学' },
  { en: 'SERVICE', title: '学术服务' },
];
---

<BaseLayout title="CV" description="Zzzode 的履历。">
  <header class="mb-10">
    <p class="eyebrow">CURRICULUM VITAE</p>
    <h1
      class="mt-3 text-[clamp(30px,4vw,40px)] font-semibold tracking-[-0.025em] text-ink"
    >
      Zzzode
    </h1>
    <p class="mt-3 text-[14.5px] text-muted">
      联系方式与详细履历待补充。
    </p>
  </header>

  <div class="space-y-12">
    {
      sections.map((section) => (
        <section>
          <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted-2">
            {section.en}
          </h2>
          <h3 class="mt-1 text-[20px] font-semibold tracking-[-0.015em] text-ink">
            {section.title}
          </h3>
          <p class="mt-3 rounded-[18px] bg-paper px-6 py-6 text-[14px] text-muted">
            待补充。
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>
