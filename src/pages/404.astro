---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 — 页面不存在。">
  <div class="rounded-[28px] bg-paper px-8 py-24 text-center">
    <p class="eyebrow">404</p>
    <h1
      class="mt-4 text-[clamp(28px,4vw,40px)] font-semibold tracking-[-0.025em] text-ink"
    >
      页面不存在
    </h1>
    <p class="mx-auto mt-4 max-w-md text-[14.5px] text-muted">
      你访问的页面可能已被移动或删除。
    </p>
    <a href="/" class="btn-primary mt-8">返回首页</a>
  </div>
</BaseLayout>
