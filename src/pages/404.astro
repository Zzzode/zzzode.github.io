---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" title="404" description="页面不存在 · Page not found">
  <div class="rounded-[28px] bg-paper px-8 py-24 text-center">
    <p class="eyebrow">404</p>
    <h1
      class="mt-4 text-[clamp(26px,4vw,38px)] font-semibold tracking-[-0.025em] text-ink"
    >
      页面不存在
      <span class="mt-1 block text-[0.72em] font-normal text-muted">Page not found</span>
    </h1>
    <p class="mx-auto mt-4 max-w-md text-[14.5px] leading-relaxed text-muted">
      你访问的页面可能已被移动或删除。<br />
      The page you were looking for may have been moved or deleted.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">返回首页</a>
      <a href="/en/" class="btn-secondary" hreflang="en">Back to home</a>
    </div>
  </div>
</BaseLayout>
