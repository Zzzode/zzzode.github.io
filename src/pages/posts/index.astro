---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntryList from '../../components/EntryList.astro';
import EmptyState from '../../components/EmptyState.astro';
import type { Entry } from '../../lib/entries';
import { formatDate } from '../../lib/format';

const posts = (
  await getCollection('posts', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const entries: Entry[] = posts.map((post) => ({
  href: `/posts/${post.id}/`,
  title: post.data.title,
  meta: formatDate(post.data.date),
  excerpt: post.data.excerpt,
  tags: post.data.tags,
}));
---

<BaseLayout title="文章" description="Zzzode 的技术文章与笔记。">
  <PageHeader eyebrow="WRITING" title="文章" lead="技术文章、研究笔记与工程实践。" />
  {
    entries.length === 0 ? (
      <EmptyState text="还没有内容，新的文章会出现在这里。" />
    ) : (
      <EntryList entries={entries} />
    )
  }
</BaseLayout>
